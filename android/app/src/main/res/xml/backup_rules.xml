<?xml version="1.0" encoding="utf-8"?>
<!--
    v1.2.1 — Android 6-11 Auto Backup opt-out.

    Body metrics, progress photos (JPEG data URLs in localStorage), and the
    workout outbox carry sensitive personal data that we do not want
    silently shipped to the user's Google Drive. Excluding the WebView
    storage paths neutralises Auto Backup for everything LimeLog persists.

    Pairs with android:allowBackup="false" on the application element and
    android:dataExtractionRules for Android 12+ (data_extraction_rules.xml).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
