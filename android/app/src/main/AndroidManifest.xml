<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Supabase OAuth callback (Google sign-in via @capacitor/browser) -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="com.limecore.workouttracker" android:host="auth" />
            </intent-filter>

            <!-- v1.3 BUG-20 — Health Connect privacy-rationale intent (required
                 by Health Connect to surface its permissions UI). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>

        <!-- v1.3 BUG-20 — alias Health Connect uses on Android < 14 to show the
             permissions-usage screen. Mirrors NCC's proven Health Connect setup. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- v1.2.1 — required by @capacitor/camera for the Body Metrics
         progress-photo capture flow. The plugin replaces the
         <input type="file" capture="environment"> path, which silently
         dropped photos on low-memory Android devices when the OS killed
         LimeLog's WebView while the camera app was in the foreground.
         The plugin persists the capture URI across Activity recreation,
         so the photo is delivered correctly even after process death.
         Permission scope is read-only at runtime — captured frames go
         straight to LimeLog's WebView localStorage and never leave the
         device (progress photos are explicitly local-only by design). -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- v1.3 BUG-20 — Health Connect read-only access to steps + active
         calories. androidx.health.connect (Jetpack), NOT GMS — F-Droid clean.
         (Declaring the Health Connect package under <queries> below is package
         visibility, not a Play-Services dependency.) -->
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" />

    <!-- v1.1.1 — Android 11+ package visibility for cross-app SSO. Apps
         must explicitly declare which other packages / providers they
         intend to interact with. Without this <queries> entry,
         ContentResolver.query() returns null on API 30+. NCC's
         SessionContentProvider validates the caller package internally
         via an allowlist (see SessionContentProvider.ALLOWED_CALLERS) —
         no custom permission needed. -->
    <queries>
        <provider android:authorities="com.limecore.nexus.session" />
        <!-- v1.3 BUG-20 — Health Connect app visibility (Android 11+). -->
        <package android:name="com.google.android.apps.healthdata" />
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
        </intent>
    </queries>
</manifest>
